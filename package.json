{
  "name": "grapesjs-storage",
  "version": "1.5.0",
  "description": "GrapesJS custom fields: templates are groups of fields (string, number, date, text, HTML) made in a form; their fields are blocks, a page's data fills them. With grapesjs-site-pages: a template per page, a data form, data records in the page tree. IndexedDB or a REST server (openapi.yaml).",
  "type": "module",
  "main": "./dist/grapesjs-storage.umd.cjs",
  "module": "./dist/grapesjs-storage.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/grapesjs-storage.umd.js",
  "jsdelivr": "./dist/grapesjs-storage.umd.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/grapesjs-storage.js",
      "require": "./dist/grapesjs-storage.umd.cjs"
    }
  },
  "files": [
    "dist",
    "openapi.yaml",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly && node -e \"require('fs').copyFileSync('dist/grapesjs-storage.umd.cjs','dist/grapesjs-storage.umd.js')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "grapesjs": ">=0.21.0 <1.0.0"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.0.0",
    "grapesjs": "0.21.13",
    "jsdom": "^25.0.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "^2.1.9"
  },
  "keywords": [
    "grapesjs",
    "grapesjs-plugin",
    "cms",
    "custom-fields",
    "structured-content",
    "templates",
    "entries",
    "headless"
  ],
  "author": "Alexander Shibisty",
  "license": "MIT"
}
