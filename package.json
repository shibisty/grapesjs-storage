{
  "name": "grapesjs-storage",
  "version": "0.1.0",
  "description": "GrapesJS plugin for structured content: mark components of a template as typed fields, keep entries that fill them, edit an entry on its locked template or in a form, render it without GrapesJS. Any backend through a ContentStore: IndexedDB, memory or a REST server (openapi.yaml).",
  "type": "module",
  "main": "./dist/grapesjs-storage.umd.cjs",
  "module": "./dist/grapesjs-storage.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/grapesjs-storage.js",
      "require": "./dist/grapesjs-storage.umd.cjs"
    }
  },
  "files": [
    "dist",
    "openapi.yaml",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "grapesjs": ">=0.21.0 <1.0.0"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.0.0",
    "grapesjs": "0.21.13",
    "jsdom": "^25.0.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "^2.1.9"
  },
  "keywords": [
    "grapesjs",
    "grapesjs-plugin",
    "cms",
    "custom-fields",
    "structured-content",
    "templates",
    "entries",
    "headless"
  ],
  "author": "Alexander Shibisty",
  "license": "MIT"
}
